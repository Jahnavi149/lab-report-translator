# Copy to .env.local (never commit .env.local) and replace the placeholder with your Meta Model API key.
META_MODEL_API_KEY=<META_API_KEY>
META_MODEL_API_URL=https://api.meta.ai/v1/chat/completions
META_MODEL=muse-spark-1.3

# Optional tuning
# MUSE_TIMEOUT_MS=45000          # per-call timeout (vision calls get 55000 by default)
# MUSE_MAX_TOKENS=8000           # output + thinking budget; Muse is a reasoning model, thinking counts against it
# MUSE_REASONING_EFFORT=low      # "off" stops sending the parameter
# OCR_TIMEOUT_MS=                # time limit for the local photo reader
