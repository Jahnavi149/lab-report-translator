# Copy to .env.local (never commit .env.local).
# Replace the placeholder with your Meta Model API key.
META_MODEL_API_KEY=<META_API_KEY>
# MODEL_API_KEY is accepted as an alias for the key above.
META_MODEL_API_URL=https://api.meta.ai/v1/chat/completions
META_MODEL=muse-spark-1.3
# Optional: per-call timeout in ms (default 30000, vision 45000).
# MUSE_TIMEOUT_MS=45000
# Optional: token budget per call (default 8000). Muse is a reasoning model; thinking counts against it.
# MUSE_MAX_TOKENS=8000
# Optional: how hard the model thinks (default low). Use "off" to not send the parameter.
# MUSE_REASONING_EFFORT=low
# Optional, for LOCAL EVALUATION ONLY, leave unset. Turns on a third-party research model (Stanford de-identifier, not from
# Meta) that the running app never uses by default. Needs `npm run models` first. The submitted app runs on Meta's Muse
# plus plain-code privacy (patterns), and photos are cleaned by patterns alone.
# PRIVACY_MODEL=1
